{
  "name": "ahtletics-insurance",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  // Build the React SPA (web/dist) before bundling/uploading the Worker. Cloudflare
  // Workers Builds runs `wrangler versions upload` from this directory, which honours
  // this custom build command, so the assets.directory below exists at deploy time.
  "build": {
    "command": "cd .. && npm install && npm run build -w web"
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "athletics-insurance-db",
      "database_id": "bf574fd6-c5f2-46bf-aed5-532b2f48aa2d"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "vars": {
    "CFO_EMAIL": "firas.azfar@gmail.com",
    // TEST MODE: Resend has no verified domain yet, so the only sender that delivers is
    // onboarding@resend.dev, and it can ONLY reach the account owner (firas.azfar@gmail.com).
    // Once a domain is verified at resend.com/domains, change this to e.g.
    // noreply@<your-verified-domain> to email coaches/students/admins. See EMAIL_SETUP.md.
    "FROM_EMAIL": "onboarding@resend.dev",
    "APP_BASE_URL": "https://ahtletics-insurance.firas-azfar.workers.dev",
    "DEV_MODE": "false"
  }
}
