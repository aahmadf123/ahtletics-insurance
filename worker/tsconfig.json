{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    // Wrangler bundles the Worker; tsc is only used for type checking here. Without
    // noEmit, the shared/ include above pushes the inferred rootDir above this package
    // and tsc complains about files outside it.
    "noEmit": true
  },
  "include": ["src/**/*.ts", "../shared/**/*.ts"]
}
